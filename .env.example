# Copy to .env.local for local development. On Vercel, set these in Project → Settings → Environment Variables.

# --- Required in production -------------------------------------------------------------------
# Postgres connection string. On Vercel: Storage → Create Database → Neon sets DATABASE_URL for you.
# Leave it unset locally to use the embedded development database in ./.data (no setup needed).
DATABASE_URL=

# Secret for signing sessions (32+ random characters). Generate one with:  npm run auth:secret
BETTER_AUTH_SECRET=

# --- Optional ----------------------------------------------------------------------------------
# Public URL of the site. On Vercel the production, branch and preview URLs are detected automatically;
# set this when you use a custom domain that is not the project's primary domain.
# BETTER_AUTH_URL=https://plans.example.com
# Extra hostnames allowed to sign in (comma separated), e.g. a second custom domain.
# AUTH_ALLOWED_HOSTS=plans.example.com,www.plans.example.com

# Sign in with GitHub (callback URL: https://<your-domain>/api/auth/callback/github)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Sign in with Google (redirect URI: https://<your-domain>/api/auth/callback/google)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Password-reset emails through Resend (https://resend.com). Without these, "Forgot password" is hidden in
# production; in development the reset link is printed in the terminal.
# RESEND_API_KEY=
# EMAIL_FROM="Headroom <no-reply@example.com>"
